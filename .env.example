# ── PrepoAI Environment Variables ──
# Copy this file to .env and replace the placeholder values with your actual API keys.
# DO NOT commit your actual .env file to version control.

# Groq API Key (Required for LLM Generation)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key (Optional: Required if using advanced Cohere Reranking in rag_engine.py)
# Get yours at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
